{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver",
    "helpers:githubDigestChangelogs",
    ":gitSignOff"
  ],
  "enabledManagers": [
    "gomod",
    "github-actions",
    "npm",
    "custom.regex"
  ],
  "ignorePaths": ["vendor/**", "website/node_modules/**"],
  "postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths", "gomodVendor"],
  "env": {
    "GOFLAGS": "-mod=mod -modcacherw"
  },
  "prHourlyLimit": 0,
  "minimumReleaseAge": "2 days",
  "internalChecksFilter": "strict",
  "labels": ["area/dependencies", "bot"],
  "semanticCommits": "disabled",
  "commitMessagePrefix": "deps:",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["**/*Dockerfile*"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?[ \\t]*\\r?\\n[ \\t]*ARG[ \\t]+\\w+=\"?(?<currentValue>[^\\s\"]+)\"?"
      ]
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "commitMessagePrefix": "deps(go):"
    },
    {
      "matchManagers": ["gomod"],
      "matchDepNames": ["github.com/google/pprof"],
      "extends": ["schedule:monthly"],
      "updateNotScheduled": false
    },
    {
      "matchFileNames": ["**/*Dockerfile*"],
      "commitMessagePrefix": "deps(dockerfile):"
    },
    {
      "matchFileNames": [".github/workflows/**"],
      "commitMessagePrefix": "deps(ci):"
    },
    {
      "matchDepNames": ["go"],
      "enabled": false
    },
    {
      "matchManagers": ["npm"],
      "commitMessagePrefix": "deps(npm):",
      "rangeStrategy": "bump"
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "enabled": false
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["github-releases"],
      "matchDepNames": [
        "moby/buildkit",
        "docker/buildx",
        "distribution/distribution"
      ],
      "versioning": "semver",
      "ignoreUnstable": false,
      "respectLatest": false
    },
    {
      "matchUpdateTypes": ["major", "minor", "patch"],
      "commitMessageAction": "bump",
      "commitMessageTopic": "{{{depName}}}",
      "commitMessageExtra": "from {{{replace '^v' '' currentValue}}} to {{{replace '^v' '' newValue}}}"
    }
  ]
}
